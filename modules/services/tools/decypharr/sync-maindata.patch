+package qbit
+
+import (
+	"net/http"
+	"strings"
+	"sync/atomic"
+
+	"github.com/sirrobot01/decypharr/internal/config"
+	"github.com/sirrobot01/decypharr/pkg/storage"
+	"github.com/sirrobot01/decypharr/internal/utils"
+)
+
+var syncRid atomic.Int64
+
+type serverState struct {
+	DlRateLimit int64 `json:"dl_rate_limit"`
+	UpRateLimit int64 `json:"up_rate_limit"`
+}
+
+func (q *QBit) handleSyncMainData(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	category := getCategory(ctx)
+	torrents, err := q.manager.Queue().ListFilter(category, config.ProtocolTorrent, storage.TorrentState(""), nil, "added_on", false)
+	if err != nil {
+		http.Error(w, "Failed to read the download queue", http.StatusInternalServerError)
+		return
+	}
+	maindata := make(map[string]interface{}, len(torrents)+2)
+	entry := make(map[string]Torrent, len(torrents))
+	for _, t := range torrents {
+		converted := convertToQBitTorrentTorrent(t)
+		entry[strings.ToLower(converted.Hash)] = converted
+	}
+	maindata["rid"] = syncRid.Add(1)
+	maindata["full_update"] = true
+	if len(entry) > 0 {
+		maindata["torrents"] = entry
+	}
+	maindata["server_state"] = serverState{}
+	utils.JSONResponse(w, maindata, http.StatusOK)
+}
