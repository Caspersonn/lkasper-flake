diff --git a/backend/src/services/download/holyarrsAskReconciler.ts b/backend/src/services/download/holyarrsAskReconciler.ts
new file mode 100644
index 0000000..70dd6b7
--- /dev/null
+++ b/backend/src/services/download/holyarrsAskReconciler.ts
@@ -0,0 +1,88 @@
+/** Ask-state reconciliation for HolyArrs library downloads. */
+
+import type { DownloadJob } from "@prisma/client";
+import { prisma } from "../../utils/db";
+import { logger } from "../../utils/logger";
+import { asPlainObject } from "../../utils/plainObject";
+import { yieldToEventLoop } from "../../utils/async";
+import {
+    ACTIVE_DOWNLOAD_JOB_STATUSES,
+    failDownloadJob,
+    patchDownloadJobMetadata,
+} from "../downloadJobStatus";
+import { holyarrsService } from "../holyarrs";
+
+interface HolyarrsAskMetadata {
+    holyarrsAskId?: number;
+    currentSource?: string;
+    statusText?: string;
+}
+
+interface ReconcileResult {
+    reconciled: number;
+    errors: number;
+}
+
+const WAITING_STATUS_TEXT = "Available in HolyArrs — waiting for library import";
+
+async function reconcileHolyarrsJob(
+    job: DownloadJob,
+): Promise<boolean> {
+    const metadata = asPlainObject(job.metadata) as HolyarrsAskMetadata;
+    const askId = metadata.holyarrsAskId;
+    if (typeof askId !== "number" || askId <= 0) return false;
+    const ask = await holyarrsService.getAsk(askId);
+    if (!ask.success || !ask.state) {
+        logger.warn(`HolyArrs ask ${askId} for job ${job.id} unreadable: ${ask.error}`);
+        if (metadata.statusText !== ask.error) {
+            await patchDownloadJobMetadata(job.id, {
+                currentSource: "holyarrs",
+                statusText: `HolyArrs ask unreadable: ${ask.error}`,
+            });
+        }
+        return false;
+    }
+    if (ask.state === "turned_down") {
+        await failDownloadJob(
+            job.id,
+            ask.error ?? "HolyArrs turned down the request",
+        );
+        logger.warn(`HolyArrs turned down ask ${askId} for job ${job.id}`);
+        return true;
+    }
+    if (ask.state === "available") {
+        const statusText = metadata.statusText ?? "";
+        if (statusText !== WAITING_STATUS_TEXT) {
+            await patchDownloadJobMetadata(job.id, {
+                currentSource: "holyarrs",
+                statusText: WAITING_STATUS_TEXT,
+            });
+            logger.info(`HolyArrs ask ${askId} available; waiting for import of job ${job.id}`);
+        }
+        return false;
+    }
+    return false;
+}
+
+/** Reconcile active HolyArrs download jobs with their native ask state. */
+export async function reconcileHolyarrsAsks(): Promise<ReconcileResult> {
+    const jobs = await prisma.downloadJob.findMany({
+        where: { status: { in: ACTIVE_DOWNLOAD_JOB_STATUSES } },
+        select: { id: true, status: true, metadata: true },
+    });
+    let reconciled = 0;
+    let errors = 0;
+    for (const job of jobs) {
+        const metadata = asPlainObject(job.metadata) as HolyarrsAskMetadata;
+        if (metadata.currentSource !== "holyarrs") continue;
+        if (typeof metadata.holyarrsAskId !== "number") continue;
+        try {
+            if (await reconcileHolyarrsJob(job as DownloadJob)) reconciled += 1;
+        } catch (error) {
+            errors += 1;
+            logger.warn(`HolyArrs reconciliation failed for job ${job.id}: ${error}`);
+        }
+        await yieldToEventLoop();
+    }
+    return { reconciled, errors };
+}
