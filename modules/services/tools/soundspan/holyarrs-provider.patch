+++ b/backend/src/services/holyarrsLibraryDownload.ts
@@ -0,0 +1,81 @@
+/** HolyArrs album ask submission and download-job metadata persistence. */
+
+import { prisma } from "../utils/db";
+import { logger as rootLogger } from "../utils/logger";
+import { asPlainObject } from "../utils/plainObject";
+import { toErrorMessage } from "../utils/errors";
+import { getSystemSettings } from "../utils/systemSettings";
+import { failDownloadJob, patchDownloadJobMetadataFrom } from "./downloadJobStatus";
+import { holyarrsService } from "./holyarrs";
+
+const logger = rootLogger.child("HolyarrsLibraryDownload");
+const HOLYARRS_DOWNLOAD_FAILED = "HolyArrs download failed";
+
+export interface HolyarrsAlbumDownloadResult {
+    success: boolean;
+    source?: "holyarrs";
+    downloadJobId?: string;
+    error?: string;
+}
+
+interface JobMetadata {
+    artistMbid?: string;
+    holyarrsAskId?: number;
+    holyarrsAttempts?: number;
+}
+
+export async function processHolyarrsDownload(
+    jobId: string,
+    artistName: string,
+    albumTitle: string,
+    userId: string,
+): Promise<HolyarrsAlbumDownloadResult> {
+    void userId;
+    void artistName;
+    void albumTitle;
+    try {
+        const job = await prisma.downloadJob.findUnique({
+            where: { id: jobId },
+            select: { metadata: true, targetMbid: true },
+        });
+        if (!job) {
+            return { success: false, error: "Download job not found" };
+        }
+        const settings = await getSystemSettings();
+        if (!settings?.musicPath) {
+            return { success: false, error: "Music path not configured" };
+        }
+        const metadata = asPlainObject(job.metadata) as JobMetadata;
+        const artistMbid = metadata.artistMbid;
+        if (typeof artistMbid !== "string" || artistMbid.length === 0) {
+            return { success: false, error: "Artist MBID required for HolyArrs request" };
+        }
+        const albumMbid = job.targetMbid;
+        if (typeof albumMbid !== "string" || albumMbid.length === 0) {
+            return { success: false, error: "Album MBID required for HolyArrs request" };
+        }
+        const ask = await holyarrsService.requestAsk(artistMbid, albumMbid);
+        if (!ask.success) {
+            await failDownloadJob(jobId, ask.error ?? HOLYARRS_DOWNLOAD_FAILED);
+            logger.warn(`HolyArrs ask rejected for job ${jobId}: ${ask.error}`);
+            return { success: false, error: ask.error };
+        }
+        await patchDownloadJobMetadataFrom(
+            job.metadata,
+            jobId,
+            {
+                currentSource: "holyarrs",
+                holyarrsAskId: ask.askId,
+                holyarrsAttempts: (metadata.holyarrsAttempts ?? 0) + 1,
+                statusText: `Requested from HolyArrs (ask ${ask.askId}, ${ask.state ?? "asked"})`,
+            },
+            { status: "processing" },
+        );
+        logger.info(`HolyArrs ask ${ask.askId} submitted for job ${jobId}`);
+        return { success: true, source: "holyarrs", downloadJobId: jobId };
+    } catch (error) {
+        const message = `HolyArrs download failed: ${toErrorMessage(error)}`;
+        logger.error(`HolyArrs processor failed for job ${jobId}: ${message}`);
+        return { success: false, error: message };
+    }
+}
