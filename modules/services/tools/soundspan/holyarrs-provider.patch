diff --git a/backend/src/services/holyarrs.ts b/backend/src/services/holyarrs.ts
new file mode 100644
index 0000000..48aa598
--- /dev/null
+++ b/backend/src/services/holyarrs.ts
@@ -0,0 +1,112 @@
+import axios, { AxiosInstance } from "axios";
+import { logger } from "../utils/logger";
+import { getSystemSettings } from "../utils/systemSettings";
+import { toErrorMessage } from "../utils/errors";
+
+const holyarrsLogger = logger.child("HolyarrsService");
+
+export type HolyarrsAskState = "asked" | "approved" | "turned_down" | "available";
+
+export interface HolyarrsAsk {
+    id: number;
+    state: HolyarrsAskState;
+    title_id?: string;
+    ready?: boolean;
+}
+
+export interface HolyarrsAskResult {
+    success: boolean;
+    askId?: number;
+    state?: HolyarrsAskState;
+    error?: string;
+}
+
+interface SystemSettingsLike {
+    holyarrsEnabled?: boolean | null;
+    holyarrsUrl?: string | null;
+    holyarrsApiKey?: string | null;
+}
+
+function client(baseUrl: string, apiKey: string): AxiosInstance {
+    return axios.create({
+        baseURL: baseUrl.replace(/\/+$/, ""),
+        timeout: 15000,
+        headers: { "X-Api-Key": apiKey, Accept: "application/json" },
+    });
+}
+
+function describeError(error: unknown): string {
+    if (axios.isAxiosError(error)) {
+        return `HolyArrs responded with HTTP ${error.response?.status ?? "unreachable"}`;
+    }
+    return toErrorMessage(error);
+}
+
+async function settings(): Promise<{ enabled: boolean; url: string; apiKey: string } | null> {
+    const settings = (await getSystemSettings()) as SystemSettingsLike | null;
+    if (!settings?.holyarrsEnabled) return null;
+    const url = settings.holyarrsUrl?.trim();
+    const apiKey = settings.holyarrsApiKey?.trim();
+    if (!url || !apiKey) return null;
+    return { enabled: true, url, apiKey };
+}
+
+export const holyarrsService = {
+    async isEnabled(): Promise<boolean> {
+        return (await settings()) !== null;
+    },
+
+    async isAvailable(): Promise<boolean> {
+        try {
+            const configured = await settings();
+            if (!configured) return false;
+            const response = await client(configured.url, configured.apiKey).get("/api/v1/auth/me");
+            return typeof response.data?.name === "string";
+        } catch (error) {
+            holyarrsLogger.warn(`HolyArrs availability probe failed: ${describeError(error)}`);
+            return false;
+        }
+    },
+
+    async requestAsk(artistMbid: string, albumMbid: string): Promise<HolyarrsAskResult> {
+        try {
+            const configured = await settings();
+            if (!configured) return { success: false, error: "HolyArrs is not configured" };
+            const response = await client(configured.url, configured.apiKey).post("/api/v1/asks", {
+                kind: "artist",
+                id: `mbid:${artistMbid}`,
+                albums: [albumMbid],
+            });
+            const ask = response.data?.ask ?? response.data;
+            const askId = Number(ask?.id);
+            if (!Number.isInteger(askId) || askId <= 0) {
+                return { success: false, error: "HolyArrs did not return an ask id" };
+            }
+            const state = ask?.state;
+            if (typeof state !== "string") {
+                return { success: true, askId, error: "HolyArrs did not report an ask state" };
+            }
+            return { success: true, askId, state: state as HolyarrsAskState };
+        } catch (error) {
+            holyarrsLogger.warn(`HolyArrs ask submission failed: ${describeError(error)}`);
+            return { success: false, error: describeError(error) };
+        }
+    },
+
+    async getAsk(askId: number): Promise<HolyarrsAskResult> {
+        try {
+            const configured = await settings();
+            if (!configured) return { success: false, error: "HolyArrs is not configured" };
+            const response = await client(configured.url, configured.apiKey).get(`/api/v1/asks/${askId}`);
+            const ask = response.data?.ask ?? response.data;
+            const state = ask?.state;
+            if (typeof state !== "string") {
+                return { success: false, error: "HolyArrs did not report an ask state" };
+            }
+            return { success: true, askId, state: state as HolyarrsAskState, error: ask?.state_reason || undefined };
+        } catch (error) {
+            holyarrsLogger.warn(`HolyArrs ask lookup failed: ${describeError(error)}`);
+            return { success: false, error: describeError(error) };
+        }
+    },
+};
diff --git a/backend/src/services/holyarrsLibraryDownload.ts b/backend/src/services/holyarrsLibraryDownload.ts
new file mode 100644
