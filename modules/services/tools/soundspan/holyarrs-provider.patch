+-- Add HolyArrs integration settings to SystemSettings (idempotent)
+DO $$
+BEGIN
+    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = 'SystemSettings')
+    AND NOT EXISTS (
+        SELECT 1 FROM information_schema.columns
+        WHERE table_name = 'SystemSettings' AND column_name = 'holyarrsApiKey'
+    ) THEN
+        ALTER TABLE "SystemSettings" ADD COLUMN "holyarrsEnabled" BOOLEAN;
+        ALTER TABLE "SystemSettings" ADD COLUMN "holyarrsUrl" TEXT;
+        ALTER TABLE "SystemSettings" ADD COLUMN "holyarrsApiKey" TEXT;
+    END IF;
+END $$;
